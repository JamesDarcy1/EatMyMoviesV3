@model ErrorViewModel
<section class="movie-not-found" aria-labelledby="error-title">
    <div class="movie-not-found-ticket">
        <p class="marquee-section-label movie-not-found-kicker">@Model.StatusCode</p>
        <h1 id="error-title">@Model.Heading</h1>
        <p class="movie-not-found-copy">@Model.Message</p>
        <a class="button is-primary movie-not-found-action" asp-controller="Home" asp-action="Index">Back home</a>
        <a class="button movie-not-found-action" asp-controller="Movie" asp-action="Search">Search movies</a>
        @if (Model.ShowRequestId)
        {
            <p><small>Reference: @Model.RequestId</small></p>
        }
    </div>
</section>
